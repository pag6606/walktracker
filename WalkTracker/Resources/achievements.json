    { "key": "weekly_goal", "name": "Meta semanal cumplida", "description": "Cumple tu meta de la semana", "icon": "🏆", "metric": "weeklyGoalMet", "threshold": 1, "comparison": "eq" },
    { "key": "rain_walker", "name": "Caminata bajo la lluvia", "description": "Camina con clima lluvioso", "icon": "🌧️", "metric": "weatherCategory", "threshold": "rain", "comparison": "eq" },
