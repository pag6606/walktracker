<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>es</string>
	<key>CFBundleDisplayName</key>
	<string>WalkTracker</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Usage strings obligatorias (spine, Envoltura operativa). Sin ellas el
	     sistema mata la app al pedir el permiso. -->
	<key>NSMotionUsageDescription</key>
	<string>WalkTracker usa el podómetro para contar tus pasos y estimar la distancia de cada caminata. Sin este permiso no hay producto.</string>
	<!-- Apple exige esta clave a toda app con el permiso de HealthKit, aunque solo
	     escriba: sin ella App Store Connect rechaza el binario (8.3, validación del
	     2026-09-13). WalkTracker no lee datos de Salud (non-goal de CAP-11). -->
	<key>NSHealthShareUsageDescription</key>
	<string>WalkTracker no lee tus datos de Salud: solo guarda tus caminatas como entrenamientos. Si algún día necesitara leer algo, te lo pedirá antes.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>WalkTracker guarda tus caminatas en Apple Salud como entrenamientos. Si no lo permites, la sesión se guarda igual en el dispositivo.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>WalkTracker usa tu ubicación aproximada solo para mostrar el clima de la caminata. Las coordenadas se redondean antes de salir del dispositivo.</string>
	<!-- 2.1: la app solo pide ubicación aproximada (una lectura de baja precisión para el
	     clima). El diálogo del sistema la ofrece aproximada por defecto, como declara el
	     manifiesto de privacidad (NSPrivacyCollectedDataTypeCoarseLocation). -->
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<!-- AD-15: sin esta clave el sistema no permite Live Activities. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- 8.3 · Cumplimiento de exportación, confirmado en la 2.1. La única llamada de
	     red es el clima de Open-Meteo, con el HTTPS del sistema (URLSession), que está
	     exento: no hay cifrado propio ni de terceros. Declararlo aquí evita la pregunta
	     en cada build subido. Si entra cifrado propio o de terceros, esto deja de ser
	     verdad y hay que cambiarlo antes de subir. `release-testflight.sh` comprueba el
	     valor en el binario archivado. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- AD-13: `UIDesignRequiresCompatibility` está PROHIBIDA. Liquid Glass se
	     hereda del SDK de iOS 26; no se declara nada para desactivarlo. -->
</dict>
</plist>
